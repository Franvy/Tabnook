    "0% shows the fully transparent Liquid Glass effect over your desktop. 100% fills the window with a solid background." : {
      "comment" : "A description of the background opacity slider.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 % zeigt den vollständig transparenten Liquid-Glass-Effekt über deinem Schreibtisch. 100 % füllt das Fenster mit einem einfarbigen Hintergrund."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0% 显示桌面上的完全透明 Liquid Glass 效果。100% 使用纯色背景填充窗口。"
          }
        }
