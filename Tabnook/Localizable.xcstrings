        }
      }
    },
    "Tabnook needs to read Bookmarks.plist (your favorites) and Touch Icons Cache (icons) inside ~/Library/Safari/. Select the Safari folder below and click Authorize." : {
      "comment" : "Text displayed in a dialog box that asks the user to authorize access to their Safari data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabnook muss auf Bookmarks.plist (deine Favoriten) und den Touch-Icons-Cache (Symbole) in ~/Library/Safari/ zugreifen. Wähle unten den Safari-Ordner aus und klicke auf „Autorisieren“."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabnook 需要读取 ~/Library/Safari/ 中的 Bookmarks.plist（你的收藏夹）和 Touch Icons Cache（图标）。请选择下面的 Safari 文件夹并点击“授权”。"
          }
        }
      }
    },
    "Tabnook needs to read the following to manage your favorite icons:" : {
      "comment" : "A description of the permissions that Tabnook needs to read.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabnook benötigt Zugriff auf folgende Daten, um deine Favoriten-Symbole zu verwalten:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabnook 需要读取以下内容以管理你的收藏夹图标："
          }
        }
      }
    },
    "The current list is empty; nothing to diagnose." : {
      "comment" : "Text displayed in a diagnostic report when the icon style code diagnostics is run but the current list is empty.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Liste ist leer; es gibt nichts zu diagnostizieren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前列表为空；没有可诊断的内容。"
          }
        }
      }
    },
    "This code has no mapping yet. The segmented control shows an editable fallback value; picking any style changes the database value to 0, 1, or 3." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Code gibt es noch keine Zuordnung. Die Segmentsteuerung zeigt einen bearbeitbaren Ersatzwert; die Auswahl eines Stils ändert den Datenbankwert auf 0, 1 oder 3."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代码尚无对应映射。分段控件显示可编辑的备用值；选择任意样式会将数据库值更改为 0、1 或 3。"
          }
        }
      }
    },
    "This favorite currently has no matching cache_settings row. The segmented control shows a fallback value; picking any style writes the corresponding code back to the database." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Favorit besitzt derzeit keinen passenden cache_settings-Eintrag. Die Segmentsteuerung zeigt einen Ersatzwert; die Auswahl eines Stils schreibt den entsprechenden Code zurück in die Datenbank."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此收藏夹当前没有匹配的 cache_settings 记录。分段控件显示备用值；选择任意样式会将对应代码写回数据库。"
          }
        }
      }
    },
